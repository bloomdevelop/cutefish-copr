+bool CutefishMenuBridge::handleMessage(const QDBusMessage &message,
+                                       const QDBusConnection &connection)
+{
+    if (message.type() != QDBusMessage::MethodCallMessage)
+        return false;
+
+    const QString interface = message.interface();
+    const QString member = message.member();
+    const QList<QVariant> args = message.arguments();
+
+    if (interface == QLatin1String("org.freedesktop.DBus.Properties")) {
+        if (member == QLatin1String("Get")) {
+            // (interface, property)
+            const QString name = args.value(1).toString();
+            const QVariantMap all = dbusProperties();
+            if (!all.contains(name)) {
+                connection.send(message.createErrorReply(
+                        QStringLiteral("org.freedesktop.DBus.Error.InvalidArgs"),
+                        QStringLiteral("No such property: %1").arg(name)));
+            } else {
+                QDBusMessage reply = message.createReply();
+                reply << QVariant::fromValue(QDBusVariant(all.value(name)));
+                connection.send(reply);
+            }
+            return true;
+        }
+        if (member == QLatin1String("GetAll")) {
+            QDBusMessage reply = message.createReply();
+            reply << QVariant::fromValue(dbusProperties());
+            connection.send(reply);
+            return true;
+        }
+        return false;
+    }
+
+    if (interface != QLatin1String(kMenuInterface))
+        return false;
+
+    if (member == QLatin1String("GetLayout")) {
+        const int parentId = args.value(0).toInt();
+        const int depth = args.value(1).toInt();
+        const CutefishMenuLayoutItem layout = buildLayout(parentId, depth);
+        QDBusMessage reply = message.createReply();
+        reply << QVariant::fromValue(m_revision) << QVariant::fromValue(layout);
+        connection.send(reply);
+        return true;
+    }
+
+    if (member == QLatin1String("GetProperty")) {
+        const int id = args.value(0).toInt();
+        const QString name = args.value(1).toString();
+        QVariantMap properties;
+        if (id == 0)
+            properties = buildLayout(0, 0).properties;
+        else if (QAction *action = actionFor(id))
+            properties = layoutProperties(action);
+        QDBusMessage reply = message.createReply();
+        reply << QVariant::fromValue(QDBusVariant(properties.value(name)));
+        connection.send(reply);
+        return true;
+    }
+
+    if (member == QLatin1String("AboutToShow")) {
+        const int id = args.value(0).toInt();
+        if (QAction *action = actionFor(id); action && action->menu())
+            QMetaObject::invokeMethod(action->menu(), "aboutToShow", Qt::DirectConnection);
+        QDBusMessage reply = message.createReply();
+        reply << QVariant::fromValue(false);
+        connection.send(reply);
+        // The application may have brought the entries up to date while it
+        // answered; ask the shell to read them again.
+        QMetaObject::invokeMethod(
+                this,
+                [this, id] {
+                    ++m_revision;
+                    sendLayoutUpdated(id);
+                },
+                Qt::QueuedConnection);
+        return true;
+    }
+
+    if (member == QLatin1String("Event") || member == QLatin1String("EventGroup")) {
+        if (member == QLatin1String("Event")) {
+            const int id = args.value(0).toInt();
+            const QString event = args.value(1).toString();
+            if (event == QLatin1String("clicked")) {
+                if (QAction *action = actionFor(id))
+                    action->trigger();
+            }
+            QDBusMessage reply = message.createReply();
+            connection.send(reply);
+        } else {
+            QDBusMessage reply = message.createReply();
+            reply << QVariant::fromValue(QList<int>());
+            connection.send(reply);
+        }
+        return true;
+    }
+
+    connection.send(message.createErrorReply(
+            QDBusError::UnknownMethod,
+            QStringLiteral("com.canonical.dbusmenu has no method %1").arg(member)));
+    return true;
+}
