+
+#ifndef CUTEFISHMENUBAR_H
+#define CUTEFISHMENUBAR_H
+
+#include <QDBusArgument>
+#include <QDBusConnection>
+#include <QDBusVirtualObject>
+#include <QHash>
+#include <QPointer>
+#include <QSet>
+#include <QStringList>
+#include <QVariantMap>
+
+#include <qpa/qplatformmenu.h>
+
+class QAction;
+class QMenu;
+class QMenuBar;
+class QWindow;
+
+// One entry of the com.canonical.dbusmenu layout, as the menu bar in the
+// shell reads it: GetLayout returns the root of a tree of these.
+struct CutefishMenuLayoutItem
+{
+    int id = 0;
+    QVariantMap properties;
+    QList<CutefishMenuLayoutItem> children;
+};
+
+QDBusArgument &operator<<(QDBusArgument &argument, const CutefishMenuLayoutItem &item);
+const QDBusArgument &operator>>(const QDBusArgument &argument, CutefishMenuLayoutItem &item);
+
+Q_DECLARE_METATYPE(CutefishMenuLayoutItem)
+
+// The com.canonical.dbusmenu object of one window's menu bar. It reads the
+// window's QMenuBar whenever the shell asks, so menus an application builds
+// and changes while it runs are always current.
+class CutefishMenuBridge : public QDBusVirtualObject
+{
+public:
+    explicit CutefishMenuBridge(QObject *parent = nullptr);
+    ~CutefishMenuBridge() override;
+
+    void setAddress(const QDBusConnection &connection, const QString &path);
+    void setMenuBar(QMenuBar *menuBar);
+    QMenuBar *menuBar() const;
+
+    QString introspect(const QString &path) const override;
+    bool handleMessage(const QDBusMessage &message, const QDBusConnection &connection) override;
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    CutefishMenuLayoutItem buildLayout(int parentId, int depth);
+    CutefishMenuLayoutItem actionItem(QAction *action, int depth);
+    void fillProperties(CutefishMenuLayoutItem &item, QAction *action) const;
+    int idFor(QAction *action);
+    QAction *actionFor(int id) const;
+    void watchMenu(QMenu *menu);
+    void scheduleUpdate();
+    void sendLayoutUpdated(int parent);
+    QVariantMap dbusProperties() const;
+
+    static QString convertMnemonic(const QString &label);
+    static QList<QStringList> shortcutOf(const QKeySequence &sequence);
+    static QVariantMap layoutProperties(QAction *action);
+
+    QPointer<QMenuBar> m_menuBar;
+    QDBusConnection m_connection;
+    QString m_path;
+    QHash<QAction *, int> m_ids;
+    QHash<int, QAction *> m_actions;
+    QSet<QObject *> m_watched;
+    int m_nextId = 1;
+    uint m_revision = 1;
+    bool m_updateQueued = false;
+};
+
+// The platform menu bar of the Cutefish theme. It takes a window's menu bar
+// over, so the application draws none, and serves it to the shell from a
+// D-Bus connection of its own. The application's session-bus connection can
+// stop delivering object calls (some Qt applications do); a connection made
+// here for the menu alone keeps working.
+class CutefishMenuBar : public QPlatformMenuBar
+{
+public:
+    explicit CutefishMenuBar(QObject *parent = nullptr);
+    ~CutefishMenuBar() override;
+
+    void insertMenu(QPlatformMenu *menu, QPlatformMenu *before) override;
+    void removeMenu(QPlatformMenu *menu) override;
+    void syncMenu(QPlatformMenu *menu) override;
+    void handleReparent(QWindow *newParentWindow) override;
+    QPlatformMenu *menuForTag(quintptr tag) const override;
+
+private:
+    void registerFor(QWindow *window);
+    void unregister();
+    void callRegistrar(const QString &method);
+    QMenuBar *menuBarFor(QWindow *window) const;
+
+    QWindow *m_window = nullptr;
+    QString m_connectionName;
+    QDBusConnection m_connection;
+    QString m_path;
+    QPointer<CutefishMenuBridge> m_bridge;
+    quint64 m_windowId = 0;
+    bool m_registeredWithRegistrar = false;
+};
+
+#endif // CUTEFISHMENUBAR_H
