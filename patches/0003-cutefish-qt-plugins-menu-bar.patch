+static const char *const kMenuInterface = "com.canonical.dbusmenu";
+static const char *const kRegistrarService = "com.canonical.AppMenu.Registrar";
+static const char *const kRegistrarPath = "/com/canonical/AppMenu/Registrar";
+static const char *const kRegistrarInterface = "com.canonical.AppMenu.Registrar";
+
+// The longest a menu bar waits for the registrar to answer, in milliseconds.
+static constexpr int kRegistrarTimeout = 2000;
+
+// Each menu bar exports one path on one connection; the counters keep both
+// apart when a process has several windows, or opens and closes them.
+static uint s_connectionCounter = 0;
+static uint s_pathCounter = 0;
+
+// The desktop services of the running platform integration, while the
+// application is still up.
+static QDesktopUnixServices *desktopServices()
+{
+    if (!QGuiApplication::instance())
+        return nullptr;
+    QPlatformIntegration *integration = QGuiApplicationPrivate::platformIntegration();
+    return integration ? dynamic_cast<QDesktopUnixServices *>(integration->services()) : nullptr;
+}
+
+static void ensureMenuTypes()
+{
+    static const bool registered = [] {
+        qDBusRegisterMetaType<CutefishMenuLayoutItem>();
+        // A dbusmenu shortcut, and the ids of a group reply, travel as
+        // containers of containers; without these the variant map holding
+        // them cannot be marshalled.
+        qDBusRegisterMetaType<QList<QStringList>>();
+        qDBusRegisterMetaType<QList<int>>();
+        return true;
+    }();
+    Q_UNUSED(registered);
+}
+
+QDBusArgument &operator<<(QDBusArgument &argument, const CutefishMenuLayoutItem &item)
+{
+    argument.beginStructure();
+    argument << item.id << item.properties;
+    argument.beginArray(QMetaType::fromType<QDBusVariant>());
+    for (const CutefishMenuLayoutItem &child : item.children)
+        argument << QDBusVariant(QVariant::fromValue(child));
+    argument.endArray();
+    argument.endStructure();
+    return argument;
+}
+
+const QDBusArgument &operator>>(const QDBusArgument &argument, CutefishMenuLayoutItem &item)
+{
+    item = CutefishMenuLayoutItem();
+    argument.beginStructure();
+    argument >> item.id >> item.properties;
+    argument.beginArray();
+    while (!argument.atEnd()) {
+        QDBusVariant variant;
+        argument >> variant;
+        const QDBusArgument childArgument = qvariant_cast<QDBusArgument>(variant.variant());
+        CutefishMenuLayoutItem child;
+        childArgument >> child;
+        item.children.append(child);
+    }
+    argument.endArray();
+    argument.endStructure();
+    return argument;
+}
