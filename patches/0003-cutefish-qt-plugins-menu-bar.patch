+CutefishMenuBridge::CutefishMenuBridge(QObject *parent)
+    : QDBusVirtualObject(parent)
+    , m_connection(QString())
+{
+    ensureMenuTypes();
+}
+
+CutefishMenuBridge::~CutefishMenuBridge()
+{
+    if (m_menuBar)
+        m_menuBar->removeEventFilter(this);
+    for (QObject *watched : std::as_const(m_watched)) {
+        if (watched)
+            watched->removeEventFilter(this);
+    }
+}
+
+void CutefishMenuBridge::setAddress(const QDBusConnection &connection, const QString &path)
+{
+    m_connection = connection;
+    m_path = path;
+}
+
+QMenuBar *CutefishMenuBridge::menuBar() const
+{
+    return m_menuBar;
+}
+
+void CutefishMenuBridge::setMenuBar(QMenuBar *menuBar)
+{
+    if (m_menuBar == menuBar)
+        return;
+    m_menuBar = menuBar;
+    if (m_menuBar)
+        m_menuBar->installEventFilter(this);
+    m_ids.clear();
+    m_actions.clear();
+    m_watched.clear();
+    m_nextId = 1;
+    ++m_revision;
+}
+
+QString CutefishMenuBridge::convertMnemonic(const QString &label)
+{
+    // dbusmenu marks the mnemonic with an underscore, Qt with an ampersand.
+    const int index = label.indexOf(QLatin1Char('&'));
+    if (index < 0 || index == label.size() - 1)
+        return label;
+    QString converted(label);
+    converted[index] = QLatin1Char('_');
+    return converted;
+}
+
+QList<QStringList> CutefishMenuBridge::shortcutOf(const QKeySequence &sequence)
+{
+    QList<QStringList> shortcuts;
+    for (int i = 0; i < sequence.count(); ++i) {
+        const QString text = QKeySequence(sequence[i]).toString(QKeySequence::PortableText);
+        if (text.isEmpty())
+            continue;
+        const QStringList parts = text.split(QLatin1Char('+'));
+        QStringList keys;
+        for (int part = 0; part < parts.size(); ++part) {
+            const QString token = parts.at(part);
+            if (part == parts.size() - 1)
+                keys << token;
+            else if (token == QLatin1String("Ctrl") || token == QLatin1String("Control"))
+                keys << QStringLiteral("Control");
+            else if (token == QLatin1String("Meta") || token == QLatin1String("Super"))
+                keys << QStringLiteral("Super");
+            else if (token == QLatin1String("Alt"))
+                keys << QStringLiteral("Alt");
+            else if (token == QLatin1String("Shift"))
+                keys << QStringLiteral("Shift");
+            else if (token == QLatin1String("Num"))
+                keys << QStringLiteral("Num");
+            else
+                keys << token;
+        }
+        shortcuts << keys;
+    }
+    return shortcuts;
+}
+
+QVariantMap CutefishMenuBridge::layoutProperties(QAction *action)
+{
+    QVariantMap properties;
+    properties.insert(QStringLiteral("label"), convertMnemonic(action->text()));
+    properties.insert(QStringLiteral("enabled"), action->isEnabled());
+    properties.insert(QStringLiteral("visible"), action->isVisible());
+    if (action->isSeparator())
+        properties.insert(QStringLiteral("type"), QStringLiteral("separator"));
+    if (action->menu())
+        properties.insert(QStringLiteral("children-display"), QStringLiteral("submenu"));
+    if (action->isCheckable()) {
+        const bool radio = action->actionGroup() && action->actionGroup()->isExclusive();
+        properties.insert(QStringLiteral("toggle-type"),
+                          radio ? QStringLiteral("radio") : QStringLiteral("checkmark"));
+        properties.insert(QStringLiteral("toggle-state"), action->isChecked() ? 1 : 0);
+    }
+    const QString iconName = action->icon().name();
+    if (!iconName.isEmpty())
+        properties.insert(QStringLiteral("icon-name"), iconName);
+    if (!action->shortcut().isEmpty())
+        properties.insert(QStringLiteral("shortcut"), QVariant::fromValue(shortcutOf(action->shortcut())));
+    return properties;
+}
+
+void CutefishMenuBridge::fillProperties(CutefishMenuLayoutItem &item, QAction *action) const
+{
+    item.properties = layoutProperties(action);
+}
+
+int CutefishMenuBridge::idFor(QAction *action)
+{
+    const auto existing = m_ids.constFind(action);
+    if (existing != m_ids.constEnd())
+        return *existing;
+
+    const int id = m_nextId++;
+    m_ids.insert(action, id);
+    m_actions.insert(id, action);
+    connect(action, &QAction::changed, this, &CutefishMenuBridge::scheduleUpdate);
+    connect(action, &QObject::destroyed, this, [this, action] {
+        m_actions.remove(m_ids.take(action));
+        scheduleUpdate();
+    });
+    if (QMenu *menu = action->menu())
+        watchMenu(menu);
+    return id;
+}
+
+QAction *CutefishMenuBridge::actionFor(int id) const
+{
+    return m_actions.value(id, nullptr);
+}
+
+void CutefishMenuBridge::watchMenu(QMenu *menu)
+{
+    if (!menu || m_watched.contains(menu))
+        return;
+    m_watched.insert(menu);
+    menu->installEventFilter(this);
+    connect(menu, &QMenu::aboutToShow, this, &CutefishMenuBridge::scheduleUpdate);
+    connect(menu, &QObject::destroyed, this, [this, menu] { m_watched.remove(menu); });
+}
+
+bool CutefishMenuBridge::eventFilter(QObject *watched, QEvent *event)
+{
+    if (watched == m_menuBar || m_watched.contains(watched)) {
+        switch (event->type()) {
+        case QEvent::ActionAdded:
+        case QEvent::ActionRemoved:
+        case QEvent::ActionChanged:
+        case QEvent::EnabledChange:
+        case QEvent::Hide:
+        case QEvent::Show:
+            scheduleUpdate();
+            break;
+        default:
+            break;
+        }
+    }
+    return false;
+}
+
+void CutefishMenuBridge::scheduleUpdate()
+{
+    if (m_updateQueued || !m_connection.isConnected() || m_path.isEmpty())
+        return;
+    m_updateQueued = true;
+    QMetaObject::invokeMethod(
+            this,
+            [this] {
+                m_updateQueued = false;
+                ++m_revision;
+                sendLayoutUpdated(0);
+            },
+            Qt::QueuedConnection);
+}
+
+void CutefishMenuBridge::sendLayoutUpdated(int parent)
+{
+    if (!m_connection.isConnected() || m_path.isEmpty())
+        return;
+    QDBusMessage signal = QDBusMessage::createSignal(m_path, QString::fromLatin1(kMenuInterface),
+                                                     QStringLiteral("LayoutUpdated"));
+    signal << m_revision << parent;
+    m_connection.send(signal);
+}
+
+CutefishMenuLayoutItem CutefishMenuBridge::buildLayout(int parentId, int depth)
+{
+    depth = qBound(0, depth, 4);
+
+    CutefishMenuLayoutItem item;
+    item.id = parentId;
+    if (parentId == 0) {
+        item.properties.insert(QStringLiteral("children-display"), QStringLiteral("submenu"));
+        if (m_menuBar && depth != 0) {
+            const QList<QAction *> actions = m_menuBar->actions();
+            for (QAction *action : actions)
+                item.children.append(actionItem(action, depth - 1));
+        }
+        return item;
+    }
+    if (QAction *action = actionFor(parentId))
+        return actionItem(action, depth);
+    return item;
+}
+
+CutefishMenuLayoutItem CutefishMenuBridge::actionItem(QAction *action, int depth)
+{
+    CutefishMenuLayoutItem item;
+    item.id = idFor(action);
+    fillProperties(item, action);
+    if (depth != 0 && action->menu()) {
+        watchMenu(action->menu());
+        const QList<QAction *> actions = action->menu()->actions();
+        for (QAction *child : actions)
+            item.children.append(actionItem(child, depth - 1));
+    }
+    return item;
+}
+
+QVariantMap CutefishMenuBridge::dbusProperties() const
+{
+    return {
+        {QStringLiteral("Version"), uint(4)},
+        {QStringLiteral("TextDirection"), QStringLiteral("ltr")},
+        {QStringLiteral("Status"), QStringLiteral("normal")},
+        {QStringLiteral("IconThemePath"), QStringList()},
+    };
+}
