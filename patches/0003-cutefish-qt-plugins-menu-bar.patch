+QMenuBar *CutefishMenuBar::menuBarFor(QWindow *window) const
+{
+    if (!window)
+        return nullptr;
+    const QList<QWidget *> windows = QApplication::topLevelWidgets();
+    for (QWidget *widget : windows) {
+        if (widget->windowHandle() != window)
+            continue;
+        if (QMenuBar *bar = widget->findChild<QMenuBar *>())
+            return bar;
+    }
+    return nullptr;
+}
+
+void CutefishMenuBar::handleReparent(QWindow *newParentWindow)
+{
+    // Qt repeats this call when the window is shown, and when a menu bar is
+    // replaced on the same window; only the latter needs a new export.
+    if (newParentWindow == m_window && m_bridge
+        && m_bridge->menuBar() == menuBarFor(newParentWindow)) {
+        return;
+    }
+    unregister();
+    m_window = newParentWindow;
+    if (m_window)
+        registerFor(m_window);
+}
+
+void CutefishMenuBar::registerFor(QWindow *window)
+{
+    QMenuBar *bar = menuBarFor(window);
+    if (!bar)
+        return;
+
+    if (m_connectionName.isEmpty()) {
+        m_connectionName = QStringLiteral("cutefish-menu-%1-%2")
+                                   .arg(QCoreApplication::applicationPid())
+                                   .arg(++s_connectionCounter);
+        m_connection = QDBusConnection::connectToBus(QDBusConnection::SessionBus, m_connectionName);
+        if (!m_connection.isConnected()) {
+            qWarning("Cutefish menu bar: cannot connect to the session bus");
+            m_connectionName.clear();
+            return;
+        }
+    }
+
+    m_path = QStringLiteral("/CutefishMenuBar/%1").arg(++s_pathCounter);
+    auto *bridge = new CutefishMenuBridge;
+    bridge->setAddress(m_connection, m_path);
+    bridge->setMenuBar(bar);
+    if (!m_connection.registerVirtualObject(m_path, bridge)) {
+        qWarning("Cutefish menu bar: cannot export %s", qPrintable(m_path));
+        delete bridge;
+        m_path.clear();
+        return;
+    }
+    m_bridge = bridge;
+
+    if (QGuiApplication::platformName() == QLatin1String("xcb")) {
+        m_windowId = quint64(window->winId());
+        QDBusMessage call = QDBusMessage::createMethodCall(
+                QString::fromLatin1(kRegistrarService), QString::fromLatin1(kRegistrarPath),
+                QString::fromLatin1(kRegistrarInterface), QStringLiteral("RegisterWindow"));
+        call << uint(m_windowId) << QDBusObjectPath(m_path);
+        const QDBusMessage reply = m_connection.call(call, QDBus::Block, kRegistrarTimeout);
+        if (reply.type() == QDBusMessage::ErrorMessage) {
+            qWarning("Cutefish menu bar: cannot register the window menu: %s",
+                     qPrintable(reply.errorMessage()));
+        } else {
+            m_registeredWithRegistrar = true;
+        }
+    } else if (QDesktopUnixServices *services = desktopServices()) {
+        services->registerDBusMenuForWindow(window, m_connection.baseService(), m_path);
+    }
+}
+
+void CutefishMenuBar::callRegistrar(const QString &method)
+{
+    if (!m_connection.isConnected() || m_windowId == 0)
+        return;
+    QDBusMessage call = QDBusMessage::createMethodCall(
+            QString::fromLatin1(kRegistrarService), QString::fromLatin1(kRegistrarPath),
+            QString::fromLatin1(kRegistrarInterface), method);
+    call << uint(m_windowId);
+    m_connection.call(call, QDBus::Block, kRegistrarTimeout);
+}
+
+void CutefishMenuBar::unregister()
+{
+    if (m_bridge) {
+        if (m_registeredWithRegistrar) {
+            callRegistrar(QStringLiteral("UnregisterWindow"));
+        } else if (m_window) {
+            if (QDesktopUnixServices *services = desktopServices())
+                services->unregisterDBusMenuForWindow(m_window);
+        }
+        if (m_connection.isConnected() && !m_path.isEmpty())
+            m_connection.unregisterObject(m_path);
+        delete m_bridge;
+    }
+
+    m_bridge = nullptr;
+    m_path.clear();
+    m_windowId = 0;
+    m_registeredWithRegistrar = false;
+    m_window = nullptr;
+}
